{
    "name": "pontoon-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "scripts": {
        "test": "jest",
        "test-coverage": "jest --collect-coverage",
        "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry https://npm.lumigame.com",
        "stats": "nodemon --es-module-specifier-resolution=node --watch ./tests ./tests/result-statistic.js"
    },
    "jest": {
        "transform": {
            "^.+\\.jsx?$": "babel-jest"
        }
    },
    "author": "pentagon",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "amqplib": "^0.6.0",
        "body-parser": "^1.19.0",
        "express": "^4.17.1",
        "helmet": "^3.23.3",
        "lodash": "^4.17.19",
        "lodash.findindex": "^4.6.0",
        "lodash.sortby": "^4.7.0",
        "moment": "^2.29.0",
        "morgan": "^1.10.0",
        "sc-game-base": "4.0.0",
        "d3-array": "^3.2.0",
        "random-js": "^2.1.0"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.14.7",
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^9.1.2",
        "@types/jest": "^26.0.23",
        "babel-jest": "^27.0.2",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "jest": "^29.6.4",
        "jest-extended": "^4.0.1",
        "jest-micro-auto-stub": "^1.0.9",
        "jest-sonar-reporter": "^2.0.0",
        "nodemon": "3.0.1"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    }
}
